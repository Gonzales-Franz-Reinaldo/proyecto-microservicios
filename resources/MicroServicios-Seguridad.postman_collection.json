					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Verifica que la solicitud haya sido exitosa (código 200)",
									"if (pm.response.code === 200) {",
									"    // 1. Parsea el cuerpo JSON de la respuesta",
									"    var jsonData = pm.response.json();",
									"    ",
									"    // 2. Extrae el valor del campo \"token\"",
									"    var token = jsonData.token;",
									"    ",
									"    // 3. Guarda el token en la variable de entorno 'accessToken'",
									"    // ¡Asegúrate de que el entorno esté seleccionado!",
									"    pm.environment.set(\"accessToken\", token);",
									"    ",
									"    // Opcional: Muestra un mensaje en la Consola de Postman para confirmar",
									"    console.log(\"Nuevo token guardado en la variable: \" + token);",
									"} else {",
									"    console.error(\"Fallo de login. No se pudo obtener el token.\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
