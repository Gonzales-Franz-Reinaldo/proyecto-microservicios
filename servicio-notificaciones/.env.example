# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=notificaciones_compras

# SMTP (Ahora requeridos por el código)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_sender@gmail.com
SMTP_PASS=your_strong_smtp_password 

# Servicios externos 
USUARIOS_SERVICE_URL=http://localhost:3000
EVENTOS_SERVICE_URL=http://localhost:3001

JWT_SECRET=your_strong_jwt_secret_key

LOG_LEVEL=info
NODE_ENV=development